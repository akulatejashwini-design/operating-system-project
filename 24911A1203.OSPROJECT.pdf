/Title (${isAllocated ? block.size - block.process.size : block.size} KB</span></div> ${isAllocated ? `<button onclick="deallocateProcess\(${index}\)" class="text-xs bg-red-100 text-red-600 hover:bg-red-200 px-2 py-1 rounded transition border border-red-200"> Free Memory </button>` : `<button onclick="removeBlock\(${index}\)" class="text-xs text-gray-400 hover:text-red-500 px-2 py-1 rounded transition"> <i class="fas fa-times"></i> </button>`} </div></div>`; memoryContainer.appendChild\(blockEl\); }\);} // Add Memory Block addBlockBtn.addEventListener\('click', \(\) => { const size = parseInt\(blockSizeInput.value\); if \(isNaN\(size\) || size <= 0\) { addLog\( "Invalid block size. Please enter a positive number.", "error"\); return;} blockCount++; memoryBlocks.push\({ id: blockCount, size: size, process: null}\); addLog\( `Added memory Block ${blockCount} of size ${size} KB.`, "system"\); blockSizeInput.value = ''; renderMemory\(\);}\); // Remove Block window.removeBlock = function\(index\) { const block = memoryBlocks[index]; if \(block.process !== null\) { addLog\(`Cannot remove Block ${block.id}; it is currently in use.`,"error"\); return;})
