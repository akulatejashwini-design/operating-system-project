/Title (}if \(memoryBlocks.length === 0\) { addLog\( "No memory blocks available. Please add blocks first.", "warning"\); return;} processCount++; const newProcess = { id: processCount, size: size}; const algo = getAlgorithm\(\); let allocatedIndex = -1; addLog\(`Attempting to allocate Process ${newProcess.id} \(${size} KB\) using ${algo}...`\); // First Fit if \(algo === 'firstFit'\) { for \(let i = 0; i < memoryBlocks.length; i++\) { if \(memoryBlocks[i].process === null &&memoryBlocks[i].size >= size\) { allocatedIndex = i; break;}}} // Best Fit else if \(algo === 'bestFit'\) { let minDiff = Infinity; for \(let i = 0; i < memoryBlocks.length; i++\) { if \( memoryBlocks[i].process === null && memoryBlocks[i].size >= size\) { let diff = memoryBlocks[i].size - size; if \(diff < minDiff\) { minDiff = diff; allocatedIndex = i;}}}} // Worst Fit else if \(algo === 'worstFit'\) { let maxDiff = -1; for \(let i = 0; i < memoryBlocks.length; i++\) { if \(memoryBlocks[i].process === null &&memoryBlocks[i].size >= size \) { let diff = memoryBlocks[i].size - size; if \(diff > maxDiff\) { maxDiff = diff; allocatedIndex = i; }} }})
